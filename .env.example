# Copy to .env.local (or .env.development / .env.production) and adjust. NEXT_PUBLIC_* values are
# read at build time and shipped to the browser, so never put a secret in one.

# Backend API origin the browser calls.
NEXT_PUBLIC_API_URL=https://api.fertilitygrove.click

# This app's own public URL (links in shares, invites, metadata).
NEXT_PUBLIC_APP_URL=https://fertilitygrove.click

# development | production
NEXT_PUBLIC_APP_MODE=development
